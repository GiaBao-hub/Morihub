repeat wait() until game:IsLoaded()
local ID = game.PlaceId
local Players = game:GetService("Players")
local plr = Players.LocalPlayer
local VirtualUser = game:GetService("VirtualUser")

-- Anti-AFK
plr.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
    print("Anti-AFK Loaded Successfully")
end)

function GetGame()
    if ID == 86639052909924 or ID == 119477642078428 then
        return "VersePiece.lua"
    elseif ID == 95295765150201 or ID == 72064813230771 then
        task.wait(2)
        if plr then
            plr:Kick("Script is under maintenance for reworking, Please wait")
        end
        return "RockFruit.lua"
    else
        warn("Not supported")
        return nil
    end
end

local gameScript = GetGame()
if not gameScript then
    return
end

print("Game Supported: " .. gameScript)

local success, response = pcall(function()
    return game:HttpGet("https://raw.githubusercontent.com/meobeo8/elgato/a/" .. gameScript)
end)

if success and response then
    loadstring(response)()
else
    warn("Failed to fetch script for game")
end
